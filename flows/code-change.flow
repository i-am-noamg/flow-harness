name: code-change

inputs:
  task: string
  simple:
    type: boolean
    default: false

steps:
  - id: inspect
    type: agent
    model: cheap
    prompt: prompts/inspect.md
    when: simple == false
    outputs: [repo_summary]
    inputs: [task]

  - id: plan
    type: agent
    model: strongest
    prompt: prompts/plan.md
    when: simple == false
    inputs: [task, repo_summary]
    outputs: [plan]

  - id: implement
    type: agent
    model: capable
    prompt: prompts/implement.md
    inputs: [task, plan]
    writes: true

  - id: test
    type: command
    command: npm test

  - id: repair
    type: agent
    model: capable
    prompt: prompts/repair.md
    when: test.exit_code != 0
    inputs: [task, plan, implement.output, test.exit_code, test.output]
    writes: true

  - id: verify_after_repair
    type: command
    command: npm test
    when: test.exit_code != 0
