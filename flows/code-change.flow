name: code-change
description: Use when you need an agent to inspect, plan, implement, and test a code change in the current repository.

inputs:
  task:
    type: string
    description: The coding task to implement.
  simple:
    type: boolean
    default: false
    description: Skip dedicated inspect and plan agents and let the implementation agent inspect directly.

outputs:
  changed: implement.changed
  changed_files: implement.changed_files
  tests_passed: test.outcome == passed
  tests_status: test.status

steps:
  - id: inspect
    type: agent
    model: cheap
    thinkingLevel: low
    prompt: inspect.md
    when: simple == false
    outputs: [repo_summary]
    inputs: [task]

  - id: plan
    type: agent
    model: strongest
    thinkingLevel: high
    prompt: plan.md
    when: simple == false
    inputs: [task, repo_summary]
    outputs: [plan]

  - id: implement
    type: agent
    model: capable
    thinkingLevel: medium
    prompt: implement.md
    inputs: [task, plan]
    writes: true

  - id: check_and_repair
    type: loop
    maxIterations: 5
    until: test.outcome == passed && (lint.outcome == passed || lint.outcome == unavailable)
    when: implement.changed == true
    steps:
      - id: lint
        type: check
        script: lint
        required: false
        parallel: true
        console: on-failure
      - id: test
        type: check
        script: test
        parallel: true
        console: on-failure
      - id: repair
        type: agent
        model: cheap
        thinkingLevel: medium
        prompt: repair.md
        history: true
        when: lint.outcome == failed || test.outcome == failed
        inputs: [task, plan, repair.history, lint.outcome, lint.exit_code, lint.failure_output, test.outcome, test.exit_code, test.failure_output]
        writes: true
