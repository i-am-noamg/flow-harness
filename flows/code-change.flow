name: code-change
description: Use when you need an agent to inspect, plan, implement, and test a code change in the current repository.

inputs:
  task:
    type: string
    description: The coding task to implement.
  simple:
    type: boolean
    default: false
    description: Use for narrow, well-scoped changes with clear expected behavior; skips dedicated inspect and plan agents so implementation inspects directly.

outputs:
  changed: implement.changed
  changed_files: implement.changed_files
  tests_passed: if(implement.changed == false, true, test.exit_code == 0)
  tests_status: if(implement.changed == false, "skipped", test.status)

steps:
  - id: inspect
    type: agent
    model: cheap
    thinkingLevel: low
    prompt: inspect.md
    when: simple == false
    outputs: [repo_summary]
    inputs: [task]

  - id: plan
    type: agent
    model: strongest
    thinkingLevel: high
    prompt: plan.md
    when: simple == false
    inputs: [task, repo_summary]
    outputs: [plan]

  - id: implement
    type: agent
    model: capable
    thinkingLevel: medium
    prompt: implement.md
    inputs: [task, plan]
    writes: true

  - id: check_and_repair
    type: loop
    maxIterations: 5
    until: lint.exit_code == 0 && test.exit_code == 0
    when: implement.changed == true
    steps:
      - id: lint
        type: exec
        program: npm
        args: [run, lint, --if-present]
        parallel: true
        console: on-failure
      - id: test
        type: exec
        program: npm
        args: [test]
        parallel: true
        console: on-failure
      - id: repair
        type: agent
        model: cheap
        thinkingLevel: medium
        prompt: repair.md
        history: true
        when: lint.exit_code != 0 || test.exit_code != 0
        inputs: [task, plan, repair.history, lint.exit_code, lint.output, test.exit_code, test.output]
        writes: true
