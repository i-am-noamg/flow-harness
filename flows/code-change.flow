name: code-change
description: Use when you need an agent to inspect, plan, implement, and test a code change in the current repository.

inputs:
  task:
    type: string
    description: The coding task to implement.
  simple:
    type: boolean
    default: false
    description: Skip inspection and planning when the implementation approach is already known.

steps:
  - id: inspect
    type: agent
    model: cheap
    prompt: prompts/inspect.md
    when: simple == false
    outputs: [repo_summary]
    inputs: [task]

  - id: plan
    type: agent
    model: strongest
    prompt: prompts/plan.md
    when: simple == false
    inputs: [task, repo_summary]
    outputs: [plan]

  - id: implement
    type: agent
    model: capable
    prompt: prompts/implement.md
    inputs: [task, plan]
    writes: true

  - id: test_and_repair
    type: loop
    maxIterations: 5
    until: test.succeeded == true
    when: implement.changed == true
    steps:
      - id: test
        type: exec
        program: npm
        args: [test]
      - id: repair
        type: agent
        model: capable
        prompt: prompts/repair.md
        when: test.exit_code != 0
        inputs: [task, plan, implement.output, test.exit_code, test.output]
        writes: true
