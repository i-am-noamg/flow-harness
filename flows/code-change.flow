name: code-change
description: Use when you need an agent to inspect, plan, implement, and test a code change in the current repository.

inputs:
  task:
    type: string
    description: The coding task to implement.
  simple:
    type: boolean
    default: false
    description: Skip inspection and planning when the implementation approach is already known.

outputs:
  changed: implement.changed
  changed_files: implement.changed_files
  tests_passed: test.exit_code == 0
  tests_status: test.status

steps:
  - id: inspect
    type: agent
    model: cheap
    prompt: inspect.md
    when: simple == false
    outputs: [repo_summary]
    inputs: [task]

  - id: plan
    type: agent
    model: strongest
    prompt: plan.md
    when: simple == false
    inputs: [task, repo_summary]
    outputs: [plan]

  - id: implement
    type: agent
    model: capable
    prompt: implement.md
    inputs: [task, plan]
    writes: true

  - id: test_and_repair
    type: loop
    maxIterations: 5
    until: test.exit_code == 0
    when: implement.changed == true
    steps:
      - id: test
        type: exec
        program: npm
        args: [test]
        output: failure
      - id: repair
        type: agent
        model: cheap
        prompt: repair.md
        history: true
        when: test.exit_code != 0
        inputs: [task, plan, implement.output, repair.history, test.exit_code, test.output]
        writes: true
