name: optimize-flow
description: Improve a named workflow and its prompts using direct review and optional saved run evidence, then validate and repair the edited workflow.

inputs:
  flow:
    type: string
    description: Name of the workflow under flows/ to optimize, without the .flow suffix.
  task:
    type: string
    default: ""
    description: Optional optimization goal or constraint; preserve the workflow contract when omitted.
  run_id:
    type: string
    default: ""
    description: Optional saved run ID under .flow/runs/ to use as baseline evidence.
  readonly:
    type: boolean
    default: false
    description: Suggest optimizations without modifying the target workflow or its prompts.

outputs:
  changed: optimize.changed
  changed_files: optimize.changed_files
  summary: optimization_summary
  baseline: baseline_evidence
  validation: if(optimize.changed == true, validate.status, "skipped")

steps:
  - id: workflow_source
    type: exec
    program: cat
    args: ["flows/{{flow}}.flow"]
    console: on-failure
    outputFormat: text
    parallel: evidence


  - id: run_summary
    type: exec
    program: node
    args:
      - -e
      - |
        const fs = require("node:fs");
        const pick = (value, keys) => Object.fromEntries(keys.filter((key) => value?.[key] !== undefined).map((key) => [key, value[key]]));
        const run = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        const steps = run.steps.map((step) => ({
          ...pick(step, ["id", "declared_id", "loop_id", "type", "status", "control", "started_at", "finished_at", "message", "error"]),
          ...(step.result ? { result: pick(step.result, ["exit_code", "signal", "timed_out", "duration", "model", "provider", "response_model", "thinking_level", "prompt_chars", "output_chars", "input_chars", "context_usage", "turns", "tool_calls", "retries", "stop_reasons", "tool_names", "effective_tools", "tool_failures", "usage", "loaded_skills", "changed", "changed_files", "iterations", "until", "maxIterations", "exhausted"]) } : {}),
        }));
        console.log(JSON.stringify({ ...pick(run, ["id", "workflow", "started_at", "status", "outputs", "finished_at", "usage", "agent_metrics", "metrics"]), steps }, null, 2));
      - ".flow/runs/{{run_id}}.json"
    when: run_id != ""
    console: on-failure
    outputFormat: text
    parallel: evidence

  - id: optimize
    type: agent
    model: capable
    thinkingLevel: high
    prompt: optimize.md
    skills: [optimize-flow]
    inputs: [flow, task, run_id, readonly, workflow_source.output, run_summary.output]
    outputs: [optimization_summary, baseline_evidence]
    outputFormat: json
    variants:
      - id: apply
        when: readonly == false
        writes: true
        tools: [read, bash, edit, write, grep, find, ls]
      - id: suggest
        when: readonly == true
        writes: false
        tools: [read, grep, find, ls]

  - id: validation_repair
    type: loop
    when: optimize.changed == true
    until: validate.exit_code == 0
    maxIterations: 3
    steps:
      - id: validate
        type: exec
        program: flow
        args: [validate, "{{flow}}"]
        console: on-failure
        outputFormat: text

      - id: repair
        type: agent
        history: true
        model: cheap
        thinkingLevel: low
        prompt: repair.md
        writes: true
        when: validate.exit_code != 0
        inputs: [flow, optimization_summary, validate.exit_code, validate.output, repair.history]
