name: git-commit
description: Use when you need to create a commit from staged changes, optionally creating a branch or pushing it to origin.

inputs:
  msg:
    type: string
    default: ""
    description: Commit message; if omitted, generate one from the Git status and diff.
  push:
    type: boolean
    default: false
    description: Push the commit to origin after committing.
  force_with_lease:
    type: boolean
    default: false
    description: Use force-with-lease when pushing; only applies with --push.
  add_all:
    type: boolean
    default: false
    description: Stage all unstaged files before committing.
  new_branch:
    type: boolean
    default: false
    description: Create a new branch before committing.
  branch:
    type: string
    default: ""
    description: Branch name to create; if omitted with --new-branch, generate one.

outputs:
  commit_message: msg || generated_commit_message
  committed: commit_details.status == succeeded
  commit_hash: commit_details.commit_hash
  branch: current_branch.branch
  committed_files: commit_details.committed_files
  pushed: push.status == succeeded || force_push.status == succeeded

steps:
  - id: add_all
    type: exec
    program: git
    args: [add, -A]
    when: add_all == true

  - id: staged_guard
    type: exec
    program: git
    args: [diff, --cached, --quiet]
    stopWhen: staged_guard.exit_code == 0
    stopMessage: "Nothing to commit: no staged changes (use --add-all to stage unstaged files)"

  - id: status
    type: exec
    program: git
    args: [status, --short]

  - id: unstaged_diff
    type: exec
    program: git
    args: [diff]
    output: failure
    when: msg == ""

  - id: staged_diff
    type: exec
    program: git
    args: [diff, --cached]
    output: failure
    when: msg == ""

  - id: generate_message
    type: agent
    model: cheap
    prompt: prompts/git-commit-message.md
    inputs: [status.output, unstaged_diff.output, staged_diff.output, new_branch, branch]
    outputs: [generated_commit_message, generated_branch]
    outputFormat: json
    when: 'msg == "" || (new_branch == true && branch == "")'

  - id: create_branch
    type: exec
    program: git
    args: [checkout, -b, "{{branch}}"]
    when: new_branch == true && branch != ""

  - id: create_generated_branch
    type: exec
    program: git
    args: [checkout, -b, "{{generated_branch}}"]
    when: new_branch == true && branch == ""

  - id: commit_supplied
    type: exec
    program: git
    args: [commit, -m, "{{msg}}"]
    when: msg != ""

  - id: commit_generated
    type: exec
    program: git
    args: [commit, -m, "{{generated_commit_message}}"]
    when: msg == ""

  - id: commit_details
    type: exec
    program: git
    args: [show, --format=%H, --name-only, --no-renames, HEAD]
    outputFormat: lines
    outputs: [commit_hash, committed_files]
    when: commit_supplied.exit_code == 0 || commit_generated.exit_code == 0

  - id: current_branch
    type: exec
    program: git
    args: [branch, --show-current]
    outputFormat: single-line
    outputs: [branch]
    when: commit_supplied.exit_code == 0 || commit_generated.exit_code == 0

  - id: push
    type: exec
    program: git
    args: [push, origin, HEAD]
    when: push == true && force_with_lease == false

  - id: force_push
    type: exec
    program: git
    args: [push, --force-with-lease, origin, HEAD]
    when: push == true && force_with_lease == true
